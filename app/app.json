{
  "expo": {
    "name": "Annaware Kitchen Display",
    "slug": "kitchen-display",
    "version": "1.2.0",
    "orientation": "landscape",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "android": {
      "package": "com.davcotech.kitchendisplay",
      "screenOrientation": "landscape",
      "predictiveBackGestureEnabled": false,
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "backgroundColor": "#2a2c2f"
      }
    },
    "plugins": [
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "LANDSCAPE"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 28,
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-audio",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Kitchen Display to use the microphone for voice commands.",
          "speechRecognitionPermission": "Allow Kitchen Display to use speech recognition for voice commands.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false
        }
      ],
      "expo-status-bar",
      "./plugins/withHomeLauncher"
    ],
    "icon": "./assets/icon.png"
  }
}
