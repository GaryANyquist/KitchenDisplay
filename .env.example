# Copy to .env and fill in. Never commit the real file.

# --- where the display is served ---------------------------------------------
# Open http://<this PC's name>:8790 in any browser (kitchen TV, tablet, phone).
KDS_PORT=8790
KDS_HOST=0.0.0.0
# Optional shared key. When set, the Android app (Settings -> Key) and the web page (?key=...) must send it.
# Make one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
KDS_KEY=

# Tickets turn yellow after WARN minutes and red after LATE minutes.
KDS_WARN_MINUTES=5
KDS_LATE_MINUTES=10
# Don't show open orders older than this many hours (forgotten tickets).
KDS_WINDOW_HOURS=12
# How many bumped tickets the Completed view keeps for recall.
KDS_RECALL_COUNT=40

# --- the register database (same server the kfdisplay-sync service writes) ----
DB_SERVER=localhost
DB_DATABASE=KFDisplay
# Pick ONE: PORT (fixed port, as on Gary's PC) or INSTANCE (needs SQL Browser).
DB_PORT=1433
#DB_INSTANCE=SQLEXPRESS

# The login from setup/01-create-kitchen-login.sql.
DB_USER=kitchen_display
DB_PASSWORD=

DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true
# SQL Server 2012/2014: needed for the TLS login handshake from Node 18+.
DB_LEGACY_TLS=true
